{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thanda LoRa Flasher",
  "version": "0.5.2",
  "identifier": "com.warwick.flasher-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Thanda LoRa Flasher",
        "width": 1280,
        "height": 800,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "esptool"
    ],
    "resources": []
  },
  "plugins": {}
}